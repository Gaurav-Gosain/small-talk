# Copy to .env and fill in. Never commit the real .env (it's gitignored).

# --- LiveKit (WebRTC SFU) ---
# Dev: `livekit-server --dev` gives devkey/secret on ws://localhost:7880.
# Prod: a self-hosted SFU or LiveKit Cloud.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# The default room id.
REACHY_ROOM=reachy-podcast

# --- Modal endpoints (the show brain + voices) ---
# OpenAI-compatible LLM (script writer) and Qwen3-TTS (per-robot voices).
MODAL_LLM_URL=https://your-llm-endpoint.modal.run
MODAL_LLM_KEY=sk-your-llm-key
MODAL_TTS_URL=https://your-tts-endpoint.modal.run
MODAL_TTS_KEY=sk-your-tts-key

# --- Admin ---
# Token for /#admin "mission control" (x-admin-token header). Generate with:
#   openssl rand -hex 16
ADMIN_TOKEN=change-me
